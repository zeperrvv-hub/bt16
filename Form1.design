            txtId.Name = "txtId";
            txtStudentId.Name = "txtStudentId";
            txtStudent.Name = "txtStudent";
            txtQuantity.Name = "txtQuantity";
            txtQuantity.Text = "1";

            cboEquipment.Name = "cboEquipment";
            cboEquipment.DropDownStyle =
