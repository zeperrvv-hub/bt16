            cboState.Items.AddRange(new object[]
            {
                "Đang mượn",
                "Đã trả"
            });

            cboState.SelectedIndex = 0;

            dtpBorrow.Name = "dtpBorrow";
            dtpBorrow.Format = DateTimePickerFormat.Short;

            dtpDue.Name = "dtpDue";
            dtpDue.Format = DateTimePickerFormat.Short;
            dtpDue.Value = DateTime.Today.AddDays(7);

            dtpReturned.Name = "dtpReturned";
            dtpReturned.Format = DateTimePickerFormat.Short;
            dtpReturned.ShowCheckBox = true;
            dtpReturned.Checked = false;

            // THÊM CÁC TRƯỜNG
            AddField(0, "Mã phiếu", txtId);
            AddField(1, "Mã sinh viên", txtStudentId);
            AddField(2, "Tên sinh viên", txtStudent);
            AddField(3, "Thiết bị", cboEquipment);
            AddField(4, "Số lượng", txtQuantity);
            AddField(5, "Ngày mượn", dtpBorrow);
            AddField(6, "Hạn trả", dtpDue);
            AddField(7, "Ngày trả thực tế", dtpReturned);
            AddField(8, "Trạng thái", cboState);

            panelInput.Controls.Add(layoutFields, 0, 0);

            SetupButton(btnAdd, "btnAdd", "Thêm");
            SetupButton(btnUpdate, "btnUpdate", "Cập nhật");
            SetupButton(btnDelete, "btnDelete", "Xóa");
            SetupButton(btnMarkReturned,
                "btnMarkReturned", "Đánh dấu đã trả");
            SetupButton(btnReset, "btnReset", "Làm mới");

            panelButtons.Dock = DockStyle.Top;
            panelButtons.AutoSize = true;
            panelButtons.WrapContents = true;
            panelButtons.Padding = new Padding(5);

            panelButtons.Controls.AddRange(new Control[]
            {
                btnAdd,
                btnUpdate,
                btnDelete,
                btnMarkReturned,
                btnReset
            });

            panelInput.Controls.Add(panelButtons, 0, 1);
            panelLeft.Controls.Add(panelInput);
            layoutMain.Controls.Add(panelLeft, 0, 0);

            layoutRight.Dock = DockStyle.Fill;
            layoutRight.ColumnCount = 1;
            layoutRight.RowCount = 2;

            layoutRight.RowStyles.Add(
                new RowStyle(SizeType.Absolute, 75F));

            layoutRight.RowStyles.Add(
                new RowStyle(SizeType.Percent, 100F));

            panelFilter.Dock = DockStyle.Fill;
            panelFilter.AutoScroll = true;
            panelFilter.WrapContents = true;
            panelFilter.Padding = new Padding(5);

            panelFilter.Controls.Add(new Label
            {
                Text = "Mã SV / Thiết bị:",
                AutoSize = true,
                Margin = new Padding(3, 8, 5, 0)
            });

            txtSearch.Name = "txtSearch";
            txtSearch.Width = 190;
            panelFilter.Controls.Add(txtSearch);

            panelFilter.Controls.Add(new Label
            {
                Text = "Trạng thái:",
                AutoSize = true,
                Margin = new Padding(10, 8, 5, 0)
            });

            cboFilter.Name = "cboFilter";
            cboFilter.DropDownStyle =
                ComboBoxStyle.DropDownList;

            cboFilter.Items.AddRange(new object[]
            {
                "Tất cả",
                "Đang mượn",
                "Quá hạn",
                "Đã trả"
            });

            cboFilter.SelectedIndex = 0;
            panelFilter.Controls.Add(cboFilter);

            layoutRight.Controls.Add(panelFilter, 0, 0);

            dgvCheckout.Name = "dgvCheckout";
            dgvCheckout.Dock = DockStyle.Fill;
            dgvCheckout.AutoGenerateColumns = false;
            dgvCheckout.ReadOnly = true;
            dgvCheckout.AllowUserToAddRows = false;
            dgvCheckout.AllowUserToDeleteRows = false;
            dgvCheckout.MultiSelect = false;
            dgvCheckout.SelectionMode =
                DataGridViewSelectionMode.FullRowSelect;
            dgvCheckout.AutoSizeColumnsMode =
                DataGridViewAutoSizeColumnsMode.Fill;
            dgvCheckout.BackgroundColor = Color.White;
            dgvCheckout.RowHeadersVisible = false;

            AddColumn("Mã phiếu", "Id");
            AddColumn("Mã SV", "StudentId");
            AddColumn("Họ tên", "Student");
            AddColumn("Thiết bị", "Equipment");
            AddColumn("SL", "Quantity");
            AddColumn("Ngày mượn", "Borrow", "dd/MM/yyyy");
            AddColumn("Hạn trả", "Due", "dd/MM/yyyy");
            AddColumn("Ngày trả", "Returned", "dd/MM/yyyy");
            AddColumn("Trạng thái", "State");

            layoutRight.Controls.Add(dgvCheckout, 0, 1);
            layoutMain.Controls.Add(layoutRight, 1, 0);

            epCheck.ContainerControl = this;
            epCheck.BlinkStyle = ErrorBlinkStyle.NeverBlink;

            Controls.Add(layoutMain);
            Controls.Add(statusStrip1);
            Controls.Add(menuStrip1);
            MainMenuStrip = menuStrip1;

            ResumeLayout(false);
            PerformLayout();
        }

        private void AddField(int row, string title, Control control)
        {
            layoutFields.RowStyles.Add(
                new RowStyle(SizeType.Absolute, 42F));

            layoutFields.Controls.Add(new Label
            {
                Text = title,
                Dock = DockStyle.Fill,
                TextAlign = ContentAlignment.MiddleLeft
            }, 0, row);

            control.Dock = DockStyle.Fill;
            control.Margin = new Padding(3, 5, 20, 5);

            layoutFields.Controls.Add(control, 1, row);
        }

        private void SetupButton(
            Button button, string name, string title)
        {
            button.Name = name;
            button.Text = title;
            button.AutoSize = true;
            button.Height = 35;
            button.Margin = new Padding(4);
        }

        private void AddColumn(
            string header, string property, string format = null)
        {
            var column = new DataGridViewTextBoxColumn
            {
                Name = property,
                HeaderText = header,
                DataPropertyName = property,
                MinimumWidth = 75
            };

            if (!string.IsNullOrEmpty(format))
                column.DefaultCellStyle.Format = format;

            dgvCheckout.Columns.Add(column);
        }
    }
}
