            layoutFields.Dock = DockStyle.Top;
            layoutFields.AutoSize = true;
            layoutFields.ColumnCount = 2;
            layoutFields.RowCount = 9;
            layoutFields.Padding = new Padding(5);

            layoutFields.ColumnStyles.Add(
